# RecoverAI Configuration

# Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Default: local SQLite database file)
DATABASE_URL=sqlite:///./recover_ai.db

# Simulation & Model
SIMULATOR_SEED=42
AGENT_VERSION=recovery-agent-v1
POLICY_VERSION=policy-v1.0.0

# AI Provider Configuration (Optional for LLM augmentations; defaults to deterministic local fallback)
AI_PROVIDER=deterministic
OPENAI_API_KEY=
GEMINI_API_KEY=
